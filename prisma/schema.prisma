generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CUSTOMER
}

// Cash on delivery: PENDING → CONFIRMED (customer called) → SHIPPED → DELIVERED (cash received).
// RETURNED (parcel refused or not collected, back in the shop; only after SHIPPED) and CANCELLED put
// the items back in stock. Declaration order = order shown in the admin.
enum DeliveryMethod {
  HOME // courier to the customer's address, flat fee
  PICKUP // collected at the shop: no address, no fee
  STOPDESK // Yalidine relay point (StopDesk row): fee of that point, address = the point's
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  RETURNED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  orders       Order[]
}

model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  products Product[]
  // Two levels: a main category (parentId null) groups sub-categories. Max depth enforced in the actions.
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
}

model Product {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String           @default("")
  categoryId  String
  category    Category         @relation(fields: [categoryId], references: [id])
  createdAt   DateTime         @default(now())
  variants    ProductVariant[]
  images      Image[]
}

model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String      @unique
  color      String
  size       String
  price      Int // dinars (DZD), no cents
  stockCount Int         @default(0)
  images     Image[]
  orderItems OrderItem[]

  @@unique([productId, color, size])
}

model Image {
  id        String          @id @default(cuid())
  url       String
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
}

model Order {
  id          String      @id @default(cuid())
  userId      String? // null = guest order (customers have no accounts)
  user        User?       @relation(fields: [userId], references: [id])
  status      OrderStatus @default(PENDING)
  method      DeliveryMethod @default(HOME)
  stopDeskId  String? // STOPDESK orders: the point picked (kept for a Yalidine export; its text is copied into address)
  stopDesk    StopDesk?   @relation(fields: [stopDeskId], references: [id], onDelete: SetNull)
  totalAmount Int // items + shippingFee: what the courier collects
  shippingFee Int         @default(0) // flat fee from Réglages at checkout time
  // delivery (cash on delivery); defaults only so pre-existing rows migrate
  fullName    String      @default("")
  phone       String      @default("")
  wilaya      String      @default("")
  commune     String      @default("") // Latin name from lib/communes.ts; "" on orders placed before communes
  address     String      @default("") // street, n°, district (before communes: commune included)
  note        String      @default("") // admin only: call outcome, call back at…, customer's request
  courier     String      @default("") // courier key (lib/couriers.ts) the parcel was created with, "" = not sent
  tracking    String      @default("") // the courier's tracking number once the parcel is created from the admin
  labelUrl    String      @default("") // printable label link returned at creation (Yalidine family, Ecotrack)
  courierStatus    String    @default("") // last parcel status from dzship's /v1/track (its vocabulary: in_transit, delivered…)
  courierRaw       String    @default("") // the courier's own wording of that status (shown when dzship says "unknown")
  courierCheckedAt DateTime? // when the admin last refreshed the tracking
  createdAt   DateTime    @default(now())
  items       OrderItem[]
}

// Réglages (admin): a single row, id 1, inserted by its migration. Empty text = the default from lib/dict.
// The courier's stop-desk (relay) points, managed in Réglages › Transporteur (seeded with Yalidine's agencies).
// commune (+ deskId for couriers that route by desk id: Yalidine family, NOEST…) is what the API needs to send a
// parcel there. The fee is per wilaya (WilayaFee.desk), not per point.
model StopDesk {
  id      String  @id @default(cuid())
  wilaya  String // "16 - Alger", as in Order.wilaya
  name    String
  commune String  @default("") // the courier's French spelling
  address String  @default("")
  deskId  String  @default("") // the point's id in the courier's own system
  orders  Order[]
}

// Delivery fee per destination wilaya and method, in DZD (Réglages › Livraison; seeded with Yalidine's tariff,
// one row per wilaya). Read by checkout (never from the client) and shown in the cart as the wilaya changes.
model WilayaFee {
  wilaya String @id // "16 - Alger"
  home   Int // courier to the door
  desk   Int // collected at a relay point
}

model Settings {
  id             Int    @id // always 1
  storeName      String @default("")
  taglineFr      String @default("")
  taglineAr      String @default("")
  heroTitleFr    String @default("")
  heroTitleAr    String @default("")
  heroImage      String @default("") // /uploads/… URL, "" = plain ink block
  shippingTextFr String @default("")
  shippingTextAr String @default("")
  whatsapp       String @default("") // digits, international format; "" hides the button
  storeWilaya    String @default("") // Boutique tab: "16 - Alger" (lib/wilayas), shown to a customer picking up
  storeCommune   String @default("") // Boutique tab: Latin commune name of storeWilaya (lib/communes)
  storeAddress   String @default("") // Boutique tab: street, district, hours; shown to a customer picking up
  storeHoursFr   String @default("") // Boutique tab: opening hours, free text per language ("Sam–Jeu : 9h–19h"); "" = not shown
  storeHoursAr   String @default("")
  storeLat       Float? // Boutique tab: the shop's GPS position (pasted "36.7538, 3.0588"); null = no map on the home page
  storeLng       Float?
  homeEnabled    Boolean @default(true) // Livraison tab: offer "Livraison à domicile" at checkout (at least one method stays on)
  pickupEnabled  Boolean @default(false) // Livraison tab: offer "Retrait en boutique" at checkout
  stopdeskEnabled Boolean @default(false) // Livraison tab: offer "Point relais" (needs StopDesk rows too)
  lowStock       Int    @default(3) // "Stock faible" at or below this
  // Transporteur tab: the delivery company (key from lib/couriers.ts), its credentials as a JSON object of the fields
  // that courier needs, origin wilaya ("16 - Alger"; required by the Yalidine family). courierReady() = the
  // "Envoyer à …" button appears on orders.
  courier           String @default("")
  courierKeys       String @default("")
  courierFromWilaya String @default("")
  parcelOpenable   Boolean @default(false) // Livraison (debug): the customer may open the parcel before paying (dzship hasOpenPackage)
  parcelInsured    Boolean @default(false) // Livraison (debug): declare the order total as the parcel's value (insurance)
  parcelWeightKg   Float   @default(0)     // Livraison (debug): weight sent with every parcel, 0 = not sent (courier default)
}

model OrderItem {
  id              String         @id @default(cuid())
  orderId         String
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId       String
  variant         ProductVariant @relation(fields: [variantId], references: [id])
  quantity        Int
  priceAtPurchase Int
}
