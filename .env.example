DATABASE_URL="file:./dev.db"
# generate: npx auth secret  (or any 32+ random chars)
AUTH_SECRET=""
AUTH_TRUST_HOST=true
# Store name, WhatsApp number, delivery fee… are set in the admin: /admin/settings
